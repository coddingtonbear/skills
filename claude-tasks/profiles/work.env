# claude-tasks profile: work
#
# See personal.env for what a profile is. This one is the work side: a second
# Todoist bot account (Coddingtonworkbot) for the queue, and GitHub through
# the user's own login because work GitHub allows nothing else.
#
# Each profile runs on its own machine (personal here, work there), so values
# that look like they should differ -- the token variable, the root -- are the
# same in both files on purpose: it's the machine that differs. The machine's
# own ~/.claude/settings.json is the natural place to set
# CLAUDE_TASKS_PROFILE=work so the loop and every session default to it.

CLAUDE_TASKS_PROFILE=work

# Todoist: Coddingtonworkbot. Its API token lives in the work machine's
# secrets file under the TOKEN_VAR name (the same name personal.env uses,
# since the two never share a secrets file), and the account is stored in td
# there (`td auth login` / `td auth token`, then `td accounts list`).
CLAUDE_TASKS_BOT_USER=me+coddingtonbot-work@adamcoddington.net
CLAUDE_TASKS_BOT_NAME=Coddingtonworkbot
CLAUDE_TASKS_TOKEN_VAR=TODOIST_CLAUDE_API_TOKEN

# GitHub: shared with the user, so both logins are the user's own and every
# comment Claude posts starts with a robot emoji. The GH_TOKEN / GIT_AUTHOR_*
# / GIT_COMMITTER_* for this identity belong in the work machine's
# ~/.claude/settings.json `env` block (or a work tree's own
# .claude/settings.json), plus GH_HOST if work GitHub is an Enterprise host.
CLAUDE_TASKS_GITHUB_MODE=shared
CLAUDE_TASKS_GITHUB_LOGIN=coddingtonbear
CLAUDE_TASKS_USER_GITHUB_LOGIN=coddingtonbear

# Where the work checkouts live on the work machine -- the same path as the
# personal profile uses on the personal machine.
CLAUDE_TASKS_ROOT=${HOME}/Documents/Projects
