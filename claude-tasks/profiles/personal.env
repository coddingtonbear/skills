# claude-tasks profile: personal
#
# A profile is the one place the claude-tasks skill and its loop learn *which
# accounts Claude is*; the skill text itself names no account. Flat and
# shell-sourceable (KEY=VALUE, no spaces around the =), so the loop script
# sources it and the skill reads it as text. Select it with
# CLAUDE_TASKS_PROFILE=<name> in the environment (per tree, via the `env`
# block of that tree's .claude/settings.json) or `claude-tasks-loop.sh
# --profile <name>`; unset means this profile.

CLAUDE_TASKS_PROFILE=personal

# Todoist: the account Claude works from. The email is the `td --user` ref and
# the address the user shares projects with; the queue is that account's
# assignments. TOKEN_VAR names the entry in the secrets file (~/.secrets)
# holding this account's API token, which the loop's pre-check queries with.
CLAUDE_TASKS_BOT_USER=me+claude@adamcoddington.net
CLAUDE_TASKS_BOT_NAME=Coddingtonbot
CLAUDE_TASKS_TOKEN_VAR=TODOIST_CLAUDE_API_TOKEN

# GitHub. MODE `bot`: Claude posts, commits, and opens PRs as its own account,
# distinct from the user's, so the author field shows who wrote what. MODE
# `shared`: Claude acts through the user's own login and marks every comment
# it posts with a leading robot emoji instead (the skill's "GitHub identity
# modes" section). The logins are what the skill matches comments and
# reviews against.
CLAUDE_TASKS_GITHUB_MODE=bot
CLAUDE_TASKS_GITHUB_LOGIN=coddingtonbot
CLAUDE_TASKS_USER_GITHUB_LOGIN=coddingtonbear

# Where this profile's checkouts live: the loop fires from here (global mode)
# and Project resolution expects <root>/<repo name>.
CLAUDE_TASKS_ROOT=${HOME}/Documents/Projects
